# Local development sample with generated secrets. Generate fresh secrets before sharing or deploying. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=L8TcNThXQFN0wciyJ6zfuxazj95Xfhz6YGHwFNgHE-QunXmoAlh7UkDB8129ckSk
DJANGO_DEBUG=true
# Include Compose service DNS name `web` so the Streamlit container can call the API.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_VERSION=0.1.0
TIME_ZONE=UTC

# MySQL credentials; DB_USER is the application user, DB_ROOT_PASSWORD is for administration
DB_NAME=mda_backend
DB_USER=mda_app
DB_PASSWORD=IQUGWOyUCL9rHEknK6WDk7zl6IVxQ9SIgsEIE4nOwys
DB_ROOT_PASSWORD=OCmPBzgTBA6nlg4p9tgsrzkLAgHhetE4orq2EoJ2Qog
DB_CONN_MAX_AGE=60
DB_ISOLATION_LEVEL=read committed

# Host-side database and Redis access
DB_HOST=127.0.0.1
DB_PORT=3307
MYSQL_HOST_PORT=3307
CACHE_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=mda
CACHE_DEFAULT_TIMEOUT=300
CACHE_SOCKET_CONNECT_TIMEOUT=1
CACHE_SOCKET_TIMEOUT=1
CACHE_TTL_CATALOG=3600
CACHE_TTL_PORTFOLIO=60
CACHE_TTL_CANDLES_HISTORICAL=600
CACHE_TTL_CANDLES_RECENT=30
CACHE_TTL_RETURNS=300
CACHE_TTL_INDICATORS_HISTORICAL=300
CACHE_TTL_INDICATORS_RECENT=30
CACHE_RECENT_WINDOW_SECONDS=172800
CELERY_BROKER_URL=amqp://mda_app:change-me@127.0.0.1:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_WORKER_CONCURRENCY=5
REDIS_HOST_PORT=6379
RABBITMQ_USER=mda_app
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Docker Compose service network, URLs, paths and published web port
REDIS_IMAGE=redis@sha256:1f88291b4c57bdf249f02eb085a8669889b2d2954e91d4de5118a5da6b78dd53
COMPOSE_DB_HOST=db
COMPOSE_DB_PORT=3306
COMPOSE_CACHE_URL=redis://redis:6379/1
COMPOSE_CELERY_BROKER_URL=amqp://mda_app:change-me@rabbitmq:5672//
COMPOSE_CELERY_RESULT_BACKEND=rpc://
COMPOSE_INGESTION_LOCAL_ROOT=/data/ingestion
WEB_HOST_PORT=8000

# Logging and local ingestion storage
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/mda/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
INGESTION_LOCAL_ROOT=sample_data
INGESTION_SYSTEM_ROOT=var/mda-system
INGESTION_SCAN_INTERVAL_SECONDS=60
INGESTION_HASH_CHUNK_SIZE_BYTES=1048576
INGESTION_MAX_UPLOAD_BYTES=1073741824
INGESTION_MIN_CHUNK_SIZE=1
INGESTION_DEFAULT_CHUNK_SIZE=5000
INGESTION_MAX_CHUNK_SIZE=100000
INGESTION_IMPORT_MAX_FILES=500
INGESTION_STAGING_RETENTION_SUCCESS_SECONDS=3600
INGESTION_STAGING_RETENTION_FAILED_SECONDS=86400
INGESTION_STAGING_CLEANUP_INTERVAL_SECONDS=3600
INGESTION_REJECTED_RAW_MAX_BYTES=2048
INGESTION_TASK_MAX_RETRIES=5
INGESTION_TASK_SOFT_TIME_LIMIT_SECONDS=1800
INGESTION_TASK_TIME_LIMIT_SECONDS=2100
INGESTION_S3_BUCKET=
# Prefix without leading or trailing slash, e.g. market-data for s3://bucket/market-data/
INGESTION_S3_PREFIX=
INGESTION_S3_REGION=

# Production-only hardening
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# Email / password-reset (console backend prints links in the web container logs)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@marketanalytics.com
# Reset links in emails should open the Streamlit dashboard (token is pasted in UI).
FRONTEND_RESET_URL=http://localhost:8501

# Streamlit dashboard (Feature 017)
# Host-side Streamlit (outside Compose) talks to published web port:
MDA_API_BASE_URL=http://127.0.0.1:8000
# Compose streamlit service uses COMPOSE_MDA_API_BASE_URL (defaults to http://web:8000)
COMPOSE_MDA_API_BASE_URL=http://web:8000
MDA_API_TIMEOUT_SECONDS=30
# Import responses wait for S3 downloads; keep larger than MDA_API_TIMEOUT_SECONDS.
MDA_IMPORT_TIMEOUT_SECONDS=600
STREAMLIT_HOST_PORT=8501
STREAMLIT_REFERENCE_CACHE_TTL=300
STREAMLIT_MARKET_CACHE_TTL=30

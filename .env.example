# Local development sample with generated secrets. Generate fresh secrets before sharing or deploying. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=L8TcNThXQFN0wciyJ6zfuxazj95Xfhz6YGHwFNgHE-QunXmoAlh7UkDB8129ckSk
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_VERSION=0.1.0
TIME_ZONE=UTC

# MySQL credentials; DB_USER is the application user, DB_ROOT_PASSWORD is for administration
DB_NAME=mda_backend
DB_USER=mda_app
DB_PASSWORD=IQUGWOyUCL9rHEknK6WDk7zl6IVxQ9SIgsEIE4nOwys
DB_ROOT_PASSWORD=OCmPBzgTBA6nlg4p9tgsrzkLAgHhetE4orq2EoJ2Qog
DB_CONN_MAX_AGE=60
DB_ISOLATION_LEVEL=read committed

# Host-side database and Redis access
DB_HOST=127.0.0.1
DB_PORT=3307
MYSQL_HOST_PORT=3307
CACHE_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=mda
CACHE_DEFAULT_TIMEOUT=300
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
REDIS_HOST_PORT=6379

# Docker Compose service network, URLs, paths and published web port
REDIS_IMAGE=redis@sha256:1f88291b4c57bdf249f02eb085a8669889b2d2954e91d4de5118a5da6b78dd53
COMPOSE_DB_HOST=db
COMPOSE_DB_PORT=3306
COMPOSE_CACHE_URL=redis://redis:6379/1
COMPOSE_CELERY_BROKER_URL=redis://redis:6379/0
COMPOSE_CELERY_RESULT_BACKEND=redis://redis:6379/2
COMPOSE_INGESTION_LOCAL_ROOT=/data/ingestion
WEB_HOST_PORT=8000

# Logging and local ingestion storage
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/mda/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
INGESTION_LOCAL_ROOT=sample_data
INGESTION_SCAN_INTERVAL_SECONDS=60
INGESTION_HASH_CHUNK_SIZE_BYTES=1048576
INGESTION_MAX_UPLOAD_BYTES=52428800
INGESTION_MIN_CHUNK_SIZE=1
INGESTION_DEFAULT_CHUNK_SIZE=5000
INGESTION_MAX_CHUNK_SIZE=100000
INGESTION_IMPORT_MAX_FILES=500
INGESTION_STAGING_RETENTION_SUCCESS_SECONDS=3600
INGESTION_STAGING_RETENTION_FAILED_SECONDS=86400
INGESTION_STAGING_CLEANUP_INTERVAL_SECONDS=3600
INGESTION_S3_BUCKET=
INGESTION_S3_PREFIX=
INGESTION_S3_REGION=

# Production-only hardening
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

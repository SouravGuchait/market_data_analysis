{
  "family": "market-data-celery",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::463265697930:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::463265697930:role/market-data-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "celery-worker",
      "image": "463265697930.dkr.ecr.eu-north-1.amazonaws.com/market-data-web:latest",
      "essential": true,
      "command": [
        "celery",
        "-A",
        "config",
        "worker",
        "--loglevel=INFO",
        "--concurrency=2"
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/market-data-celery",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "worker",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}

{
  "family": "market-data-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::463265697930:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::463265697930:role/market-data-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "django",
      "image": "463265697930.dkr.ecr.eu-north-1.amazonaws.com/market-data-web:latest",
      "essential": true,
      "command": [
        "gunicorn",
        "config.wsgi:application",
        "--bind",
        "0.0.0.0:8000",
        "--workers",
        "3",
        "--timeout",
        "60",
        "--access-logfile",
        "-",
        "--error-logfile",
        "-"
      ],
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl --fail --silent http://127.0.0.1:8000/api/v1/health/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 40
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/market-data-web",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "django",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "streamlit",
      "image": "463265697930.dkr.ecr.eu-north-1.amazonaws.com/market-data-web:latest",
      "essential": true,
      "command": [
        "streamlit",
        "run",
        "streamlit_app/app.py",
        "--server.address=0.0.0.0",
        "--server.port=8501",
        "--server.headless=true",
        "--server.enableCORS=false"
      ],
      "portMappings": [
        {
          "containerPort": 8501,
          "protocol": "tcp"
        }
      ],
      "dependsOn": [
        {
          "containerName": "django",
          "condition": "HEALTHY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/market-data-web",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "streamlit",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "nginx",
      "image": "463265697930.dkr.ecr.eu-north-1.amazonaws.com/market-data-nginx:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "dependsOn": [
        {
          "containerName": "django",
          "condition": "START"
        },
        {
          "containerName": "streamlit",
          "condition": "START"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/market-data-web",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "nginx",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}

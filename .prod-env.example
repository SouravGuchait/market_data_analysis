# Copy to ~/.config/env_vars/prod.env and chmod 600. Never commit the copy.
# prod_up starts RDS, the messaging EC2 host, Redis/RabbitMQ, and both Fargate
# services. prod_down stops them in reverse. Redis/RabbitMQ passwords stay on
# the instance in /opt/market-data-messaging/.env.ec2
MDA_EC2_INSTANCE_ID=i-REPLACE
MDA_RDS_INSTANCE_ID=mda-sourav
MDA_ECS_CLUSTER=market-data-cluster
MDA_ECS_WEB_SERVICE=market-data-web
MDA_ECS_CELERY_SERVICE=market-data-celery
AWS_REGION=eu-north-1

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
# Add the EC2 public IP or DNS name before opening the site in a browser.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
APP_VERSION=0.1.0
TIME_ZONE=UTC

DB_NAME=mda_prod
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=replace-me.rds.amazonaws.com
DB_PORT=3306
REDIS_HOST=172.31.48.107
REDIS_PORT=6379
RABBITMQ_HOST=172.31.48.107
RABBITMQ_PORT=5672
DB_CONN_MAX_AGE=60
DB_ISOLATION_LEVEL=read committed

LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/mda/app.log
INGESTION_LOCAL_ROOT=/data/ingestion
INGESTION_SYSTEM_ROOT=/var/lib/mda/system
INGESTION_S3_BUCKET=
INGESTION_S3_PREFIX=
INGESTION_S3_REGION=eu-north-1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

NGINX_HOST_PORT=80
# Public DNS name for Nginx server_name (use _ to accept any Host header).
NGINX_SERVER_NAME=_
MDA_API_TIMEOUT_SECONDS=30
MDA_IMPORT_TIMEOUT_SECONDS=600
